{
  "name": "frost-threshold",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "npm run build && gh-pages -d dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:a11y": "playwright test",
    "wasm": "PATH=$HOME/.cargo/bin:$PATH wasm-pack build crate --target web --out-dir ../pkg",
    "verify:a11y": "vite preview --port 4400 --strictPort & VP=$!; for i in $(seq 1 20); do curl -sf http://localhost:4400/crypto-lab-frost-threshold/ >/dev/null && break; sleep 1; done; BASE_URL=http://localhost:4400/crypto-lab-frost-threshold/ node scripts/a11y-check.mjs; R=$?; kill $VP; exit $R"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.2",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.12.1",
    "gh-pages": "^6.3.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.8.3",
    "vite": "^8.2.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0"
  }
}
